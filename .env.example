# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# Cerebras — https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# SambaNova — https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=

# GitHub Models — https://github.com/settings/tokens (needs "models" scope)
GITHUB_MODELS_API_KEY=

# Local MLX server (mlx_lm.server) — opt-in
LOCAL_MLX_ENABLED=false
LOCAL_MLX_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_MLX_MODEL=mlx-community/Qwen3-30B-A3B-Instruct-2507-4bit
LOCAL_MLX_API_KEY=none
