{
  "name": "llm-engine",
  "version": "0.1.0",
  "description": "LLM routing engine with free-tier provider fallback",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:dashboard": "tsc && node -e \"require('fs').cpSync('src/dashboard/ui','dist/dashboard/ui',{recursive:true})\"",
    "dashboard": "node dist/dashboard/cli.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "GPLv3",
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "eventsource-parser": "^3.0.0",
    "zod": "^3.24.0"
  }
}
